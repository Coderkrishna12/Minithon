# PrivacyShield Backend Configuration
DATABASE_URL=sqlite+aiosqlite:///./privacyshield.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional. Without it, per-email lookups use the free XposedOrNot API.
HIBP_API_KEY=
# Requests per minute allowed by your HIBP subscription.
HIBP_RPM=10
HIBP_MODE=live
XON_MODE=live
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
DEMO_MODE=false
# How often every user's accounts are rescanned in the background. 0 disables.
MONITOR_INTERVAL_MINUTES=360
# Optional on-chain anchoring of audit-log hashes. Defaults to the Polygon Amoy testnet;
# fund the wallet from a faucet. Leave POLYGON_PRIVATE_KEY empty to keep the chain local.
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=
POLYGON_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/
ANTHROPIC_API_KEY=
# Optional. Adds semantic (embedding) search to PrivacyBot's retrieval; keyword search works without it.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
