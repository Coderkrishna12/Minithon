# PrivacyShield Backend Configuration
DATABASE_URL=sqlite+aiosqlite:///./privacyshield.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional. Without it, per-email lookups use the free XposedOrNot API.
HIBP_API_KEY=
# Requests per minute allowed by your HIBP subscription.
HIBP_RPM=10
POLYGON_RPC_URL=https://polygon-rpc.com
ANTHROPIC_API_KEY=
CONTRACT_ADDRESS=
